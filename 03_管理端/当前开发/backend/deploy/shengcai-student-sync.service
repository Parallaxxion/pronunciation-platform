[Unit]
Description=Receive one bounded page sequence from the agreed student feed
After=shengcai-management.service
Requires=shengcai-management.service

[Service]
Type=oneshot
User=shengcai
Group=shengcai
WorkingDirectory=/opt/shengcai/current/03_管理端/当前开发/backend
EnvironmentFile=/etc/shengcai/integration.env
Environment=PYTHONUTF8=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/shengcai/venv/bin/python sync_worker.py --admin http://127.0.0.1:8766 student --student ${STUDENT_BASE_URL} --source-id ${STUDENT_SOURCE_ID} --feed-path ${STUDENT_FEED_PATH}
TimeoutStartSec=600
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
