# 复制为 .env 后填写；不要把 .env 提交到 Git
APP_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:8000
PRIVACY_VERSION=v0.1

# 本地演示可留空 SMTP_HOST，注册页会显示开发验证链接。
# 正式环境请填写 SMTP 和学生能够访问的 HTTPS PUBLIC_BASE_URL。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
HF_ENDPOINT=https://hf-mirror.com
WHISPER_MODEL=small

ASR_BACKEND=whisper
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
# ASR_MODEL=small (leave unset to use selected backend default)
ASR_REVISION=master
